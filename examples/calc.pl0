program calc;

const addop:integer=1, subop:integer=2, multop:integer=3, divop:integer=4;

var op: integer, x: integer, y: integer, done: integer;

procedure add;
begin
    x := x + y;
end;

procedure sub;
begin
    x := x - y;
end;

procedure mult;
var c: integer;
begin
    x := x * y;
end;

procedure div;
begin
    if y <> 0 then
        x := x / y;
    endif;
    if y = 0 then
        done := 1;
    endif;
end;

procedure calculate;
begin
    if op = addop then
        add();
    endif;
    if op = subop then
        sub();
    endif;
    if op = multop then
        mult();
    endif;
    if op = divop then
        div();
    endif;
end;

begin
    done := 0;
    x := 20;
    while done = 0 do
        op := 1;
        if op < 1 then
            done := 1;
        endif;
        if op > 4 then
            done := 1;
        endif;
        if done = 0 then
            y := 4;
            calculate();
        endif;
    endwhile;
end.
