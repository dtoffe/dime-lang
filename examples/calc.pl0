const addop:integer=1, subop:integer=2, multop:integer=3, divop:integer=4;

var op: integer, x: integer, y: integer, done: integer;

procedure add;
begin
    x := x + y
end;

procedure sub;
begin
    x := x - y
end;

procedure mult;
var c: integer;
begin
    x := x * y
end;

procedure div;
begin
    if y <> 0 then
        x := x / y;
    if y = 0 then
        done := 1
end;

procedure calculate;
begin
    if op = addop then
        call add;
    if op = subop then
        call sub;
    if op = multop then
        call mult;
    if op = divop then
        call div
end;

begin
    done := 0;
    x := 20;
    while done = 0 do
    begin
        op := 1;
        if op < 1 then
            done := 1;
        if op > 4 then
            done := 1;
        if done = 0 then
        begin
            y := 4;
            call calculate
        end
    end
end.
