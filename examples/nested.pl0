const addop = 1, subop = 2, multop = 3, divop = 4;

var op, x, y, done;

procedure calculate;

    procedure add;
    begin
        x := x + y
    end;

    procedure sub;
    begin
        x := x - y
    end;

    procedure mult;
    var c;
    begin
        x := x * y
    end;

    procedure div;
    begin
        if y <> 0 then
            x := x / y;
        if y = 0 then
            done := 1
    end;

begin
    if op = addop then
        call add;
    if op = subop then
        call sub;
    if op = multop then
        call mult;
    if op = divop then
        call div
end;

begin
    done := 0;
    x := 20;
    while done = 0 do
    begin
        op := 1;
        if op < 1 then
            done := 1;
        if op > 4 then
            done := 1;
        if done = 0 then
        begin
            y := 4;
            call calculate
        end
    end
end.
