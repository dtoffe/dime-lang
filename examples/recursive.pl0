program recursive;

var f: integer, n: integer;

procedure fact;
var ans1: integer;
begin
    ans1 := n;
    n := n - 1;
    if n = 0 then
        f := 1;
    endif;
    if n > 0 then
        fact();
    endif;
    f := f * ans1;
end;

begin
    n := 7;
    if n < 0 then
        f := -1;
    endif;
    if n = 0 then
        f := 1;
    endif;
    if n > 0 then
        fact();
    endif;
end.
