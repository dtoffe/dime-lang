program primes;

const max: integer = 100;
var arg: integer, ret: boolean;

procedure isprime;
var i: integer;
begin
    ret := true;
    i := 2;
    while i < arg do
        if arg / i * i = arg then
            ret := false;
            i := arg;
        endif;
        i := i + 1;
    endwhile;
end;

procedure printprimes;
begin
    for arg := 2 to max - 1 by 1 do
        isprime();
        if ret then
            writeln(arg);
        endif;
    endfor;
end;

begin
    printprimes();
end.
