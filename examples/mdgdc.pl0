const m: integer = 7, n: integer = 85;

var x: integer, y: integer, z: integer, q: integer, r: integer;

procedure multiply;
    var a: integer, b: integer;
begin
    a := x;
    b := y;
    z := 0;
    while b > 0 do
        if b / 2 * 2 <> b then
            z := z + a;
        endif;
        a := 2 * a;
        b := b / 2;
    endwhile;
end;

procedure divide;
    var w: integer;
begin
    r := x;
    q := 0;
    w := y;
    while w <= r do 
        w := 2 * w;
    endwhile;
    while w > y do
        q := 2 * q;
        w := w / 2;
        if w <= r then
            r := r - w;
            q := q + 1;
        endif;
    endwhile;
end;

procedure gcd;
    var f: integer, g: integer;
begin
    f := x;
    g := y;
    while f <> g do
        if f < g then
            g := g - f;
        endif;
        if g < f then
            f := f - g;
        endif;
    endwhile;
    z := f;
end;

begin
    x := m; y := n; multiply();
    x := 25; y := 3; divide();
    x := 84; y := 36; gcd();
end.
