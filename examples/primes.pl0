const MAX = 100;
var ARG, RET;

procedure ISPRIME;
var I;
begin
    RET := 1;
    I := 2;
    while I < ARG do
    begin
        if ARG / I * I = ARG then
        begin
            RET := 0;
            I := ARG
        end;
        I := I + 1
    end
end;

procedure PRIMES;
begin
    ARG := 2;
    while ARG < MAX do
    begin
        call ISPRIME;
        ARG := ARG + 1
    end
end;

call PRIMES
.
