const max: integer = 100;
var arg: integer, ret: integer;

procedure isprime;
var i: integer;
begin
    ret := 1;
    i := 2;
    while i < arg do
    begin
        if arg / i * i = arg then
        begin
            ret := 0;
            i := arg
        end;
        endif;
        i := i + 1
    end
end;

procedure primes;
begin
    arg := 2;
    while arg < max do
    begin
        call isprime;
        arg := arg + 1
    end
end;

call primes
.
