const max: integer = 100;
var arg: integer, ret: integer;

procedure isprime;
var i: integer;
begin
    ret := 1;
    i := 2;
    while i < arg do
        if arg / i * i = arg then
            ret := 0;
            i := arg;
        endif;
        i := i + 1;
    endwhile;
end;

procedure primes;
begin
    arg := 2;
    while arg < max do
        isprime();
        arg := arg + 1;
    endwhile;
end;

begin
    primes();
end.
