llir program
globals 2
global 1 global[x]:integer/dword
global 2 global[squ]:integer/dword
procedures 2
proc 1 square return=none params=0 locals=0 temps=7 blocks=4 labels=3 instructions=13
  temp 1 temp[t1]:integer/dword
  temp 2 temp[t2]:integer/dword
  temp 3 temp[t3]:integer/dword
  temp 4 temp[t4]:boolean/byte
  temp 5 temp[t5]:integer/dword
  temp 6 temp[t6]:integer/dword
  temp 7 temp[t7]:integer/dword
  block 1 label=L1 first=1 count=2
   1 copy result=temp[t1]:integer/dword left=imm(1):integer/dword
   2 store result=global[x]:integer/dword left=temp[t1]:integer/dword
  block 2 label=L2 first=3 count=4
   3 load result=temp[t2]:integer/dword left=global[x]:integer/dword
   4 copy result=temp[t3]:integer/dword left=imm(10):integer/dword
   5 cmp_le result=temp[t4]:boolean/byte left=temp[t2]:integer/dword right=temp[t3]:integer/dword
   6 brfalse left=temp[t4]:boolean/byte target=label[L3]:address
  block 3 first=7 count=6
   7 call target=proc[calcsquare]:address
   8 load result=temp[t5]:integer/dword left=global[x]:integer/dword
   9 copy result=temp[t6]:integer/dword left=imm(1):integer/dword
  10 add result=temp[t7]:integer/dword left=temp[t5]:integer/dword right=temp[t6]:integer/dword
  11 store result=global[x]:integer/dword left=temp[t7]:integer/dword
  12 jump target=label[L2]:address
  block 4 label=L3 first=13 count=1
  13 return
  labelmap L1 block=1 first=1
  labelmap L2 block=2 first=3
  labelmap L3 block=4 first=13
endproc
proc 2 calcsquare return=none params=0 locals=0 temps=3 blocks=1 labels=1 instructions=5
  temp 1 temp[t8]:integer/dword
  temp 2 temp[t9]:integer/dword
  temp 3 temp[t10]:integer/dword
  block 1 label=L4 first=1 count=5
   1 load result=temp[t8]:integer/dword left=global[x]:integer/dword
   2 load result=temp[t9]:integer/dword left=global[x]:integer/dword
   3 mul result=temp[t10]:integer/dword left=temp[t8]:integer/dword right=temp[t9]:integer/dword
   4 store result=global[squ]:integer/dword left=temp[t10]:integer/dword
   5 return
  labelmap L4 block=1 first=1
endproc
